{
  "name": "@dammie/api",
  "version": "1.0.0",
  "description": "Dammie AI API, Telegram bot, and financial workers",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/assets && cp assets/Inter.ttf assets/Geist.ttf assets/Ojuju.ttf dist/assets/",
    "start": "bun dist/server.js",
    "dev": "PORT=3001 bun --watch src/server.ts",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "reconcile:financial": "bun src/scripts/reconcile-financial-events.ts",
    "reconcile:withdrawals": "bun src/scripts/reconcile-ngn-withdrawals.ts",
    "setup": "bun src/scripts/setup.ts",
    "admin:create": "bun src/scripts/create-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ai": "^7.0.84",
    "axios": "1.20.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "ioredis": "5.10.1",
    "node-telegram-bot-api": "2.1.0",
    "opentype.js": "^2.0.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "^24.0.10",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
